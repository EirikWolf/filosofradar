+
+// PROTOTYPE (revisjon 2026-11-17, committes ikke): stjernelaget som memo-komponent
+interface StarLayerProps {
+  sortedRadarPoints: RadarPoint[];
+  matchingIds: Set<string>;
+  selectedId: string | null;
+  hoveredId: string | null;
+  contemporaryIds: Set<string>;
+  bornRecently: Set<string>;
+  isTimeMachineActive: boolean;
+  lifeTime: number;
+  activePoint: RadarPoint | null;
+  currentArrival: RadarPoint | null;
+  setHoveredId: (id: string | null) => void;
+  setSelectedId: (id: string | null) => void;
+}
+const StarLayer = React.memo(function StarLayer({
+  sortedRadarPoints, matchingIds, selectedId, hoveredId, contemporaryIds, bornRecently,
+  isTimeMachineActive, lifeTime, activePoint, currentArrival, setHoveredId, setSelectedId,
+}: StarLayerProps) {
+  return (<>
+          {sortedRadarPoints.map((pt) => {
+            const p = pt.philosopher;
+            const meta = getTraditionMeta(pt.tradition);
+
+            const isMatches = matchingIds.has(pt.id);
+            const isSelected = selectedId === pt.id;
+            const isHovered = hoveredId === pt.id;
+            const isContemporary = contemporaryIds.has(pt.id);
+            const isBornSupernova = bornRecently.has(pt.id);
+
+            // Tidsmaskin livsstatus
+            let isAlive = true;
+            let isUnborn = false;
+            let isDeceased = false;
+
+            if (isTimeMachineActive) {
+              if (pt.birthYear > lifeTime) {
+                isUnborn = true;
+                isAlive = false;
+              } else if (pt.deathYear && pt.deathYear < lifeTime) {
+                isDeceased = true;
+                isAlive = false;
+              }
+            }
+
+            // Opasitet basert på filter og tidsmaskin
+            let opacity = 1;
+            if (!isMatches) {
+              opacity = 0.12;
+            } else if (isUnborn) {
+              opacity = 0.04;
+            } else if (isDeceased) {
+              opacity = 0.5;
+            } else if (activePoint && !isSelected && !isHovered && !isContemporary) {
+              opacity = 0.35;
+            }
+
+            // Star size
+            const baseRadius = 4.5;
+            const starRadius = isSelected || isHovered ? baseRadius * 1.5 : baseRadius;
+
+            return (
+              <g
+                key={pt.id}
+                tabIndex={isUnborn ? -1 : 0}
+                role="button"
+                aria-label={`${p.name} (${formatLifeSpan(p)})`}
+                transform={`translate(${pt.x}, ${pt.y})`}
+                opacity={opacity}
+                className={`cursor-pointer transition-opacity duration-300 focus:outline-none group`}
+                onMouseEnter={() => setHoveredId(pt.id)}
+                onMouseLeave={() => setHoveredId(null)}
+                onClick={() => {
+                  sound.playStarSelect();
+                  setSelectedId(selectedId === pt.id ? null : pt.id);
+                }}
+                onKeyDown={(e) => {
+                  if (e.key === 'Enter' || e.key === ' ') {
+                    e.preventDefault();
+                    sound.playStarSelect();
+                    setSelectedId(selectedId === pt.id ? null : pt.id);
+                  } else if (e.key === 'Escape') {
+                    setSelectedId(null);
+                    setHoveredId(null);
+                  }
+                }}
+              >
+                {/* Usynlig treffsone (forhindrer flimring/jitter på stjernekanten) */}
+                <circle r="14" fill="transparent" />
+
+                {/* Myk oppgløding ved ankomst i tidsmaskinen (erstatter snøball-effekt) */}
+                {isBornSupernova && (
+                  <circle
+                    r={starRadius * 2.2}
+                    fill={meta.color}
+                    opacity="0.4"
+                    className="animate-pulse pointer-events-none"
+                  />
+                )}
+
+                {/* Historiens Lyskaster aktiv stjerne */}
+                {isTimeMachineActive && currentArrival && currentArrival.id === pt.id && (
+                  <circle
+                    r={starRadius * 2.5}
+                    fill="none"
+                    stroke="#67e8f9"
+                    strokeWidth="1.5"
+                    strokeDasharray="3 3"
+                    className="animate-spin pointer-events-none"
+                    style={{ animationDuration: '6s' }}
+                  />
+                )}
+
+                {/* Diskret, rolig samtids-ring hvis samtidig med fokusert filosof (statisk) */}
+                {isContemporary && (
+                  <circle
+                    r={starRadius * 1.9}
+                    fill="none"
+                    stroke="#f6c85f"
+                    strokeWidth="1.2"
+                    strokeDasharray="2 2"
+                    opacity="0.65"
+                    className="pointer-events-none"
+                  />
+                )}
+
+                {/* Ytre tradisjons-aura */}
+                <circle
+                  r={starRadius * 1.8}
+                  fill={meta.color}
+                  opacity={isAlive ? 0.35 : 0.15}
+                  className="transition-transform group-hover:scale-125 pointer-events-none"
+                />
+
+                {/* Hovedstjerne */}
+                <circle
+                  r={starRadius}
+                  fill={isSelected ? '#f6c85f' : '#ffffff'}
+                  stroke={meta.color}
+                  strokeWidth={isSelected ? 2 : 1}
+                  className=" pointer-events-none"
+                />
+
+                {/* Navnelapp og levetid på radaren ved hover eller når valgt */}
+                {(isHovered || isSelected) && (
+                  <g className="pointer-events-none select-none">
+                    <text
+                      y={pt.y > 730 ? -starRadius - 16 : starRadius + 14}
+                      textAnchor="middle"
+                      fill={isSelected ? '#f6c85f' : '#ffffff'}
+                      fontSize="11"
+                      fontWeight={isSelected ? 'bold' : '600'}
+                      className="font-serif "
+                    >
+                      {p.name}
+                    </text>
+                    <text
+                      y={pt.y > 730 ? -starRadius - 5 : starRadius + 26}
+                      textAnchor="middle"
+                      fill="#ffd79e"
+                      fontSize="9"
+                      className="font-serif opacity-90 "
+                    >
+                      {formatLifeSpan(p)}
+                    </text>
+                  </g>
+                )}
+              </g>
+            );
+          })}
+  </>);
+});
